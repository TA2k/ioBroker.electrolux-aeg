{
  "type": "panel",
  "i18n": true,
  "items": {
    "username": {
      "type": "text",
      "label": "appEmail",
      "newLine": true,
      "xs": 12,
      "sm": 3,
      "md": 3,
      "lg": 3,
      "xl": 3
    },
    "password": {
      "type": "password",
      "newLine": true,
      "repeat": false,
      "visible": true,
      "xs": 12,
      "sm": 3,
      "md": 3,
      "lg": 3,
      "xl": 3,
      "label": "appPassword"
    },
    "type": {
      "type": "select",
      "newLine": true,
      "xs": 12,
      "sm": 3,
      "md": 3,
      "lg": 3,
      "xl": 3,
      "options": [
        {
          "label": "electrolux",
          "value": "electrolux"
        },
        {
          "label": "aeg",
          "value": "aeg"
        }
      ],
      "label": "appName"
    },
    "_testLogin": {
      "type": "sendTo",
      "label": "testLogin",
      "help": "testLoginHelp",
      "command": "testLogin",
      "jsonData": "{\"username\": \"${data.username}\", \"password\": \"${data.password}\", \"type\": \"${data.type}\"}",
      "icon": "auth",
      "variant": "outlined",
      "showProcess": true,
      "timeout": 35000,
      "result": {
        "loginOk": "loginOk"
      },
      "error": {
        "loginMissing": "loginMissing",
        "loginRejected": "loginRejected",
        "loginFailed": "loginFailed",
        "loginUnreachable": "loginUnreachable",
        "loginBusy": "loginBusy"
      },
      "newLine": true,
      "xs": 12,
      "sm": 3,
      "md": 3,
      "lg": 3,
      "xl": 3
    },
    "_connection": {
      "type": "state",
      "label": "connection",
      "oid": "info.connection",
      "trueText": "connected",
      "falseText": "notConnected",
      "xs": 12,
      "sm": 3,
      "md": 3,
      "lg": 3,
      "xl": 3
    },
    "interval": {
      "type": "number",
      "newLine": true,
      "min": 1,
      "max": 1440,
      "xs": 12,
      "sm": 2,
      "md": 2,
      "lg": 2,
      "xl": 2,
      "label": "updateInterval"
    }
  }
}
